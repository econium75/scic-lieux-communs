# Variables d'environnement SCIC Lieux Communs — exemple
# Copier en .env et personnaliser avant docker compose up

# Clé secrète JWT (OBLIGATOIRE en production) — générer avec : openssl rand -hex 32
SCIC_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# Domaine public (pour Caddy / CORS)
PUBLIC_DOMAIN=simulateur.scic-lieuxcommuns.fr

# Email admin (pour Let's Encrypt + alertes)
ADMIN_EMAIL=admin@scic-lieuxcommuns.fr

# URL de l'API vue depuis le frontend (dans docker-compose : backend:8000)
PUBLIC_API_URL=http://backend:8000

# Base de données (SQLite par défaut, PostgreSQL en V2)
# SCIC_DATABASE_URL=postgresql://scic:password@postgres:5432/scic
